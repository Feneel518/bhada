# Database and session
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
BETTER_AUTH_SECRET="generate-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="generate-a-random-secret-at-least-16-characters-long"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Search Console HTML tag verification token (content value only)
GOOGLE_SITE_VERIFICATION=""

# Transactional email (Nodemailer SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Bhadaa <hello@example.com>"

# Razorpay Portfolio subscription
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_PORTFOLIO_PLAN_ID="plan_your_plan_id"
# Optional: each extra plan appears at checkout once its ID is set.
RAZORPAY_PORTFOLIO_YEARLY_PLAN_ID=""   # ₹499 / year
RAZORPAY_ESTATE_PLAN_ID=""             # ₹99 / month, 20 properties / 100 units
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Public bill/receipt links (/s/...). Optional: falls back to BETTER_AUTH_SECRET.
# Changing it invalidates every link already sent to tenants.
SHARE_LINK_SECRET=""

# Optional: WhatsApp number for "send us a photo of your rent register",
# digits with country code, e.g. 919876543210. The button hides when empty.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
